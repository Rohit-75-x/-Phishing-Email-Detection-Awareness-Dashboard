# Environment Configuration Example for Phishing Email Detection & Awareness Dashboard
# Copy this file to .env for local overrides

ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DEBUG=True

# SQLite Database Location
DATABASE_PATH=backend/data/phish_events.db

# Machine Learning Engine Calibration
ML_CONFIDENCE_THRESHOLD=0.50
HYBRID_RULE_WEIGHT=0.60
HYBRID_ML_WEIGHT=0.40

# Security Policies
MAX_UPLOAD_SIZE_BYTES=5242880  # 5MB
ALLOW_CORS_ALL=True
